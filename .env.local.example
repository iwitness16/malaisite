# ─── Firebase (create your own project at console.firebase.google.com) ────────
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# ─── Site domain (no trailing slash) ─────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://elitepartz.com

# ─── Admin WhatsApp (digits only, no + or spaces) ────────────────────────────
NEXT_PUBLIC_ADMIN_WHATSAPP=15072009576

# ─── Gmail App Password (for order email notifications) ──────────────────────
# 1. Enable 2FA on your Gmail account
# 2. Go to myaccount.google.com/apppasswords
# 3. Generate a new app password for "Mail"
# 4. Paste the 16-character code below (no spaces)
GMAIL_USER=elitepartz.orders@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password_here

# ─── Admin email (receives order notifications) ───────────────────────────────
ADMIN_EMAIL=elitepartz.orders@gmail.com
